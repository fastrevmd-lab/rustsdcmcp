# A durable SSH tunnel to the rustsdcmcp listener, for an operator workstation.
#
# The server binds 127.0.0.1:30032 and is not exposed directly, so reaching it
# means forwarding a local port. Running that by hand is fine; making it durable
# is where it goes wrong, and this template exists because it did.
#
# Install as a *user* unit, not a system one -- it authenticates as you:
#
#   mkdir -p ~/.config/systemd/user
#   sed 's/@DEPLOYMENT_HOST@/your-host.example/' \
#     rustsdcmcp-tunnel.service.example > ~/.config/systemd/user/rustsdcmcp-tunnel.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now rustsdcmcp-tunnel.service
#
# Then point the MCP client at http://127.0.0.1:30032/mcp.

[Unit]
Description=SSH tunnel to the rustsdcmcp MCP listener
Documentation=https://github.com/fastrevmd-lab/rustsdcmcp/blob/main/docs/operations.md
# Deliberately no `Wants=network-online.target`. This is a *user* unit, and the
# user manager has its own unit namespace -- that target lives in the system
# manager, so the dependency resolves to nothing and delays nothing. Naming it
# would look like readiness handling while providing none, which is the failure
# mode this whole file exists to avoid. Offline starts are handled by the
# budget below instead.

# The reason this file exists.
#
# systemd's default start limit is 5 starts in 10 seconds. With RestartSec=5s a
# unit restarts at most twice in that window, so the limit never trips and a
# tunnel pointed at a host that no longer resolves retries every five seconds
# forever, reporting `activating (auto-restart)` rather than a failure. One
# built from a documented snippet did exactly that for about thirty days.
#
# The budget also has to survive being started offline. A user manager can come
# up before the network does, and with no usable readiness dependency (see
# above) those first attempts fail on DNS in milliseconds. A tight budget would
# be spent in under a minute, leaving the tunnel `failed` for the rest of the
# session -- permanently broken by a transient condition, which is the opposite
# of the intent.
#
# 20 attempts at RestartSec=30s spans roughly ten minutes even when every
# attempt fails instantly, and longer once ConnectTimeout is actually reached.
# That rides out a boot-before-network or a suspend, and still makes a name that
# has genuinely stopped resolving terminal within the hour rather than retrying
# for thirty days.
#
# These numbers are one design. Raising ConnectTimeout or RestartSec without
# raising the interval puts the limit back out of reach; shrinking the interval
# reintroduces the offline-start failure.
#
# These are [Unit] keys, not [Service] ones -- they moved in systemd 229, and
# in [Service] they are parsed, reported as "Unknown key ... ignoring", and do
# nothing. An inert guard here would reproduce the exact bug this file exists
# to prevent.
StartLimitIntervalSec=3600
StartLimitBurst=20

[Service]
Type=exec

# `-N` runs no remote command, `-T` asks for no TTY. `ExitOnForwardFailure`
# makes ssh fail loudly when the local port is already bound instead of
# connecting and quietly forwarding nothing.
#
# The forward names `127.0.0.1` explicitly, and `GatewayPorts=no` is set, rather
# than relying on the default. An operator with `GatewayPorts yes` in
# `~/.ssh/config` -- globally or for this host -- turns a bare
# `-L 30032:...` into a wildcard listener, which would publish this MCP endpoint
# to the workstation's network. The server binds loopback precisely so that
# cannot happen; a tunnel that undoes it is worse than no tunnel, and it would
# be silent.
#
# `ServerAliveInterval`/`ServerAliveCountMax` are what turn a silently dead TCP
# connection into an exit: without them a tunnel across a dropped link stays
# "running" while forwarding nothing, which is the failure this unit is least
# able to notice on its own.
#
# `BatchMode=yes` is what makes the rest of the bounding meaningful. Without it
# ssh may fall back to a password prompt or invoke an askpass helper from the
# graphical session, then wait for an answer that never comes. `ConnectTimeout`
# does not bound authentication, so an unanswered prompt hangs past every limit
# in this file: the unit stays `activating`, the restart policy never fires, and
# the start limit is never reached. The key must be pre-provisioned and either
# unencrypted or already loaded into an agent the unit can reach.
#
# `ConnectTimeout` bounds the attempt itself. Without it a blackholed TCP
# connect falls back to the system timeout, which can exceed two minutes -- ten
# such attempts do not fit in the 600s window below, so the start limit would
# never trip and the unit would retry forever. That is the same failure this
# file exists to prevent, arrived at from the other direction: a rate limit only
# works if attempts are faster than the window.
ExecStart=/usr/bin/ssh -N -T \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o GatewayPorts=no \
    -o ConnectTimeout=30 \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -L 127.0.0.1:30032:127.0.0.1:30032 \
    root@@DEPLOYMENT_HOST@

Restart=on-failure
RestartSec=30s


[Install]
WantedBy=default.target
